# Example Environment Variables for QuietHorizon

# Model Configuration
# Path to local model file (if not using HuggingFace download)
# QUIET_HORIZON_MODEL_PATH=/path/to/quiet_horizon_cnn.keras

# Hugging Face Configuration
# HF_HOME=/path/to/huggingface/cache
# HF_TOKEN=your_hf_token_here  # Only needed for private models

# Audio Processing
# TARGET_SAMPLE_RATE=22050
# SPECTROGRAM_SIZE=128

# Logging
# LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Frontend Configuration (Streamlit)
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=localhost
# STREAMLIT_THEME_BASE=light

# Development
# DEBUG=False
# ENABLE_PROFILING=False
